<Window x:Class="CursedPasswordManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Language="pt-BR" Title="Cursed Password Manager" Width="1180" Height="800" MinWidth="920" MinHeight="640" WindowStartupLocation="CenterScreen" Icon="Assets/cursed.ico">
 <Window.InputBindings><KeyBinding Key="L" Modifiers="Control" Command="{Binding LockCommand}"/><KeyBinding Key="G" Modifiers="Control" Command="{Binding GenerateCommand}"/><KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCommand}"/></Window.InputBindings>
 <Grid Background="{DynamicResource BackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource TitleBrush}" BorderBrush="{DynamicResource HighlightBrush}" BorderThickness="0,1,0,1">
   <Grid Margin="24,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image Source="Assets/cursed.png" Width="54" Height="54" Margin="0,0,16,0"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Cursed Password Manager" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock Text="Suas senhas. Seu computador. Suas regras." Foreground="#E9EEFF" FontSize="12" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding LockLabel}" Foreground="White" HorizontalAlignment="Right" Margin="0,0,0,5"/><Button Content="Bloquear  ·  Ctrl+L" Command="{Binding LockCommand}" Margin="0" Padding="12,5" Visibility="{Binding IsUnlocked, Converter={StaticResource BoolVisibility}}"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="24,20,24,0">
   <TabControl SelectedIndex="{Binding Page}" Visibility="{Binding IsUnlocked,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanInteract}">
    <TabItem Header="⚡  Gerador de Senhas"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,0,0">
     <TextBlock Text="Uma senha nova. Um problema a menos." Style="{StaticResource Heading}"/><TextBlock Text="Aleatoriedade criptográfica, sem sair deste computador." Style="{StaticResource Caption}"/>
     <Border Style="{StaticResource Card}" Margin="0,10,0,16"><StackPanel>
      <DockPanel><TextBlock Text="SUA PRÓXIMA SENHA" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="100% OFFLINE" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryBrush}" FontWeight="Bold"/></DockPanel>
      <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="18" Margin="0,16,0,12"><TextBlock Text="{Binding GeneratedDisplay}" FontFamily="Consolas" FontSize="23" TextWrapping="Wrap" MinHeight="40" VerticalAlignment="Center" AutomationProperties.Name="Senha gerada"/></Border>
      <TextBlock Text="{Binding Entropy}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,18"/>
      <WrapPanel><Button Content="⚡ Gerar senha" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Copiar" Command="{Binding CopyGeneratedCommand}"/><Button Content="Mostrar / ocultar" Command="{Binding RevealGeneratedCommand}"/><Button Content="＋ Salvar no cofre" Command="{Binding SaveGeneratedCommand}"/></WrapPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Do seu jeito" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Comprimento · de 10 a 60 caracteres"/><Slider Minimum="10" Maximum="60" Value="{Binding Length}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,18,15" AutomationProperties.Name="Comprimento da senha"/></StackPanel><TextBox Grid.Column="1" Text="{Binding Length,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" AutomationProperties.Name="Quantidade de caracteres"/></Grid>
      <WrapPanel><CheckBox Content="Números  0–9" IsChecked="{Binding Digits}"/><CheckBox Content="Minúsculas  a–z" IsChecked="{Binding Lowercase}"/><CheckBox Content="Maiúsculas  A–Z" IsChecked="{Binding Uppercase}"/><CheckBox Content="Símbolos  !@#" IsChecked="{Binding Symbols}"/></WrapPanel>
      <CheckBox Content="Garantir pelo menos um caractere de cada grupo selecionado" IsChecked="{Binding RequireEach}"/>
      <TextBlock Text="A estimativa considera as opções de geração. Alguns serviços limitam tamanhos e caracteres. Use uma senha diferente para cada conta." Style="{StaticResource Caption}"/>
     </StackPanel></Border>
     <TextBlock Text="Dica: Ctrl+G gera uma nova senha. Senhas geradas só são gravadas quando você escolhe salvar." Style="{StaticResource Caption}"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="▣  Senhas Armazenadas"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,0,0">
     <DockPanel><Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="＋ Nova credencial" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/><StackPanel><TextBlock Text="Tudo no lugar certo." Style="{StaticResource Heading}"/><TextBlock Text="Encontre, organize e cuide das suas contas." Style="{StaticResource Caption}"/></StackPanel></DockPanel>
     <TextBlock Text="Pesquisar por serviço ou conta" Style="{StaticResource Caption}" Margin="0,4,0,0"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBox Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pesquisar serviço ou conta" ToolTip="Pesquisar serviço ou conta"/><ComboBox Grid.Column="1" ItemsSource="{Binding FilterCategories}" SelectedItem="{Binding FilterCategory}" Margin="10,4,8,12" AutomationProperties.Name="Filtrar categoria"/><ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" AutomationProperties.Name="Ordenar credenciais"/></Grid>
     <WrapPanel><CheckBox Content="★ Somente favoritos" IsChecked="{Binding FavoritesOnly}"/><Button Content="Nova categoria" Command="{Binding NewCategoryCommand}"/><Button Content="Renomear categoria" Command="{Binding RenameCategoryCommand}"/><Button Content="Excluir categoria" Command="{Binding DeleteCategoryCommand}"/></WrapPanel>
     <Grid Margin="0,8,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><ListBox ItemsSource="{Binding Credentials}" SelectedItem="{Binding Selected}" MinHeight="280" MaxHeight="390" AutomationProperties.Name="Credenciais"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding FavoriteMark}" FontSize="21" Foreground="{DynamicResource AccentBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Service}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Account}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="Nenhuma credencial encontrada.&#x0a;Adicione uma conta ou ajuste os filtros." TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding EmptyVault,Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False"/></Grid>
      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0"><StackPanel>
       <TextBlock Text="{Binding Selected.Service,TargetNullValue='Seu espaço seguro'}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Selected.Account}" Style="{StaticResource Caption}"/>
       <Border Background="{DynamicResource InputBrush}" Padding="12" CornerRadius="4" Margin="0,8,0,14"><TextBlock Text="{Binding SelectedPassword}" FontFamily="Consolas" FontSize="17" TextWrapping="Wrap"/></Border>
       <WrapPanel><Button Content="Copiar senha" Command="{Binding CopyPasswordCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Mostrar / ocultar" Command="{Binding RevealCommand}"/><Button Content="Copiar conta" Command="{Binding CopyAccountCommand}"/><Button Content="Editar" Command="{Binding EditCommand}"/><Button Content="☆ Favorito" Command="{Binding FavoriteCommand}"/><Button Content="Histórico" Command="{Binding HistoryCommand}"/><Button Content="Excluir" Command="{Binding DeleteCommand}"/></WrapPanel>
       <TextBlock Text="{Binding Selected.CreatedLocal,StringFormat='Criada: {0:g}'}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Selected.ModifiedLocal,StringFormat='Alterada: {0:g}'}" Style="{StaticResource Caption}"/>
      </StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button Content="Analisar meu cofre" Command="{Binding AuditCommand}" DockPanel.Dock="Right" HorizontalAlignment="Right"/><TextBlock Text="Check-up de senhas" FontSize="19" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding AuditSummary}" Style="{StaticResource Caption}"/><ListBox ItemsSource="{Binding Findings}" MaxHeight="200" SelectionChanged="AuditSelected" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Service}" FontWeight="SemiBold"/><TextBlock Text="{Binding Reasons}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="Análise local por regras. Não consulta vazamentos e não garante que uma senha nunca foi exposta. Selecione um resultado para abrir a credencial." Style="{StaticResource Caption}"/></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="⚙  Configurações"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,0,0">
     <TextBlock Text="Seu cofre, com a sua cara." Style="{StaticResource Heading}"/><TextBlock Text="Personalize a aparência e mantenha suas cópias em dia." Style="{StaticResource Caption}"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Aparência" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/><UniformGrid Columns="3">
      <Button Command="{Binding ClassicCommand}" Padding="10"><StackPanel><Border Background="#ECE9D8" Width="220" Height="80" BorderBrush="#8FA7C4" BorderThickness="1" CornerRadius="5"><StackPanel><Border Background="#245EDB" Height="22" CornerRadius="4,4,0,0"><TextBlock Text="Cursed Password Manager" Foreground="White" FontSize="10" Margin="8,3"/></Border><Border Background="White" Margin="10" Height="32" BorderBrush="#8FA7C4" BorderThickness="1"><TextBlock Text="••••••••••••" Foreground="#172B48" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Border><TextBlock Text="Windows XP Classic" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
      <Button Command="{Binding CursedXpCommand}" Padding="10"><StackPanel><Border Background="#221333" Width="220" Height="80" BorderBrush="#785793" BorderThickness="1" CornerRadius="5"><StackPanel><Border Background="#7B3FC5" Height="22" CornerRadius="4,4,0,0"><TextBlock Text="Cursed Password Manager" Foreground="White" FontSize="10" Margin="8,3"/></Border><Border Background="#302044" Margin="10" Height="32" BorderBrush="#F6CF55" BorderThickness="1"><TextBlock Text="••••••••••••" Foreground="#F6CF55" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Border><TextBlock Text="Cursed XP" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
      <Button Command="{Binding ModernCommand}" Padding="10"><StackPanel><Border Background="#111116" Width="220" Height="80" BorderBrush="#42404E" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Text="Cursed Password Manager" Foreground="#C6A0FF" FontSize="10" Margin="10,8,0,0"/><Border Background="#1D1D26" Margin="10" Height="30" CornerRadius="6"><TextBlock Text="••••••••••••" Foreground="#F3F1FA" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Border><TextBlock Text="Cursed Modern" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
     </UniformGrid></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Segurança" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/><WrapPanel><Button Content="Alterar senha mestra" Command="{Binding ChangeMasterCommand}"/><Button Content="Ativar / desativar Windows Hello" Command="{Binding HelloCommand}"/><Button Content="Bloquear agora" Command="{Binding LockCommand}"/></WrapPanel><TextBlock Text="{Binding HelloStatus}" Style="{StaticResource Caption}"/><WrapPanel><StackPanel Width="250" Margin="0,0,20,0"><TextBlock Text="Bloqueio por inatividade (1–120 min)"/><TextBox Text="{Binding Settings.AutoLockMinutes}" AutomationProperties.Name="Minutos de inatividade"/></StackPanel><StackPanel Width="250"><TextBlock Text="Limpeza ao copiar (5–120 segundos)"/><TextBox Text="{Binding Settings.ClipboardSeconds}" AutomationProperties.Name="Segundos para limpar área de transferência"/></StackPanel></WrapPanel><TextBlock Text="{Binding CryptoInfo}" Style="{StaticResource Caption}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Armazenamento e recuperação" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Pasta principal"/><DockPanel><Button Content="Escolher…" Command="{Binding ChoosePrimaryCommand}" DockPanel.Dock="Right" Margin="8,4,0,12"/><TextBox Text="{Binding Settings.PrimaryFolder}" AutomationProperties.Name="Pasta principal"/></DockPanel><TextBlock Text="Pasta secundária · prefira outra unidade física"/><DockPanel><Button Content="Escolher…" Command="{Binding ChooseSecondaryCommand}" DockPanel.Dock="Right" Margin="8,4,0,12"/><TextBox Text="{Binding Settings.SecondaryFolder}" AutomationProperties.Name="Pasta secundária"/></DockPanel><CheckBox Content="Manter a cópia secundária ativa" IsChecked="{Binding Settings.SecondaryEnabled}"/><TextBlock Text="Recuperação interna automática" FontWeight="SemiBold"/><TextBlock Text="{Binding Paths.Recovery}" Style="{StaticResource Caption}"/>
      <ItemsControl ItemsSource="{Binding ReplicaStates}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel><TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Path}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding LastSynchronized,StringFormat='Última sincronização nesta sessão: {0:g}'}" FontSize="11"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <WrapPanel Margin="0,16,0,0"><Button Content="Verificar integridade" Command="{Binding VerifyCommand}"/><Button Content="Sincronizar" Command="{Binding SyncCommand}"/><Button Content="Recuperar cofre" Command="{Binding RecoverCommand}"/><Button Content="Exportar backup" Command="{Binding ExportCommand}"/><Button Content="Importar backup" Command="{Binding ImportCommand}"/></WrapPanel><TextBlock Text="Três cópias no mesmo dispositivo não protegem contra perda física, roubo ou ransomware. Mantenha uma exportação criptografada em outro local." Style="{StaticResource Caption}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Inicialização e bandeja" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/><CheckBox Content="Iniciar com Windows (indisponível no portátil)" IsChecked="{Binding Settings.StartWithWindows}"/><CheckBox Content="Iniciar minimizado" IsChecked="{Binding Settings.StartMinimized}"/><CheckBox Content="Minimizar para a bandeja" IsChecked="{Binding Settings.MinimizeToTray}"/><CheckBox Content="Ao fechar a janela, manter na bandeja" IsChecked="{Binding Settings.CloseToTray}"/><Button Content="Salvar configurações" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Cursed Password Manager  1.0.0" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Desenvolvedor: FlynnOfHearts • Licença MIT" Margin="0,8,0,0"/><TextBlock Text="C# · .NET 10 · WPF · totalmente offline" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ModeLabel}" Style="{StaticResource Caption}"/><Button Content="Abrir documentação local" Command="{Binding DocumentationCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLocked,Converter={StaticResource BoolVisibility}}"><Grid MaxWidth="880" Margin="0,20,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,45,36,0"><Image Source="Assets/cursed.png" Width="110" Height="110" HorizontalAlignment="Left"/><TextBlock Text="Privacidade com&#x0a;um toque de nostalgia." FontSize="30" FontWeight="Bold" Margin="0,24,0,12"/><TextBlock Text="Um lugar só seu para guardar as chaves da sua vida digital." Style="{StaticResource Caption}" FontSize="15"/><TextBlock Text="✓ Criptografia autenticada&#x0a;✓ Cópias automáticas&#x0a;✓ Nenhuma conta online" Margin="0,22,0,0" FontSize="14" LineHeight="30"/><TextBlock Text="Developed by FlynnOfHearts" Style="{StaticResource Caption}" Margin="0,30,0,0"/></StackPanel>
    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Center"><StackPanel IsEnabled="{Binding CanInteract}"><TextBlock Text="{Binding UnlockTitle}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding ModeLabel}" Style="{StaticResource Caption}"/><TextBlock Text="Senha mestra" Margin="0,16,0,0"/><PasswordBox x:Name="MasterPassword" MaxLength="1024" KeyDown="MasterKeyDown" AutomationProperties.Name="Senha mestra"/>
     <StackPanel Visibility="{Binding IsFirstRun,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Confirme a senha mestra"/><PasswordBox x:Name="ConfirmPassword" MaxLength="1024" AutomationProperties.Name="Confirmar senha mestra"/><TextBlock Text="Use pelo menos 12 caracteres. Uma frase longa e exclusiva é uma boa escolha. Sem a senha mestra, seus dados podem se tornar irrecuperáveis. Não existe recuperação secreta." Style="{StaticResource Caption}"/><TextBlock Text="Pasta principal"/><DockPanel><Button Content="…" Command="{Binding ChoosePrimaryCommand}" DockPanel.Dock="Right"/><TextBox Text="{Binding Settings.PrimaryFolder}"/></DockPanel><TextBlock Text="Pasta secundária"/><DockPanel><Button Content="…" Command="{Binding ChooseSecondaryCommand}" DockPanel.Dock="Right"/><TextBox Text="{Binding Settings.SecondaryFolder}"/></DockPanel></StackPanel>
     <Button Content="{Binding UnlockButton}" Click="UnlockClicked" Style="{StaticResource PrimaryButton}" Margin="0,10,0,8"/><Button Content="Desbloquear com Windows Hello" Click="HelloClicked" Margin="0,0,0,8"/><Button Content="Recuperar um cofre existente" Command="{Binding RecoverCommand}" Margin="0"/><TextBlock Text="Tudo permanece neste dispositivo. A senha mestra nunca é enviada para um servidor." Style="{StaticResource Caption}" Margin="0,18,0,0"/>
    </StackPanel></Border>
   </Grid></ScrollViewer>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SurfaceBrush}" Padding="20,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"/><ProgressBar Grid.Column="1" IsIndeterminate="True" Height="5" Margin="12,0,0,0" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}"/></Grid></Border>
 </Grid>
</Window>
